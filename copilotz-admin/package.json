{
  "name": "@copilotz/admin",
  "version": "0.8.1",
  "description": "Copilotz admin dashboard components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.ts -i ./src/styles.css -o ./dist/styles.css",
    "build:watch": "tsup --watch",
    "build:css:watch": "tailwindcss -c tailwind.config.ts -i ./src/styles.css -o ./dist/styles.css --watch",
    "dev": "npm run build:watch & npm run build:css:watch",
    "prepack": "npm run build && npm run build:css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.540.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.12",
    "tsup": "^8.3.5",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.8.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/copilotzhq/packages.git"
  },
  "homepage": "https://github.com/copilotzhq/packages#readme",
  "publishConfig": {
    "access": "public"
  }
}
