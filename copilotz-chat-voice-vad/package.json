{
  "name": "@copilotz/chat-voice-vad",
  "version": "0.9.38",
  "description": "Optional VAD-powered voice provider for Copilotz chat voice compose",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "npm run build:watch",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@copilotz/chat-ui": "0.9.38",
    "@ricky0123/vad-web": "^0.0.30",
    "onnxruntime-web": "^1.24.3"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~5.8.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/copilotzhq/packages.git"
  },
  "homepage": "https://github.com/copilotzhq/packages#readme",
  "publishConfig": {
    "access": "public"
  }
}
